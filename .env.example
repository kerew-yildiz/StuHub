# StuHub DS — ortam değişkenleri şablonu
# Bu dosyayı `.env` olarak kopyalayıp gerçek değerleri girin.
# `.env` git'e ASLA commit edilmez (.gitignore'da). Anahtarınızı kimseyle paylaşmayın.

# Ücretsiz LLM sağlayıcı zinciri — geçici çözüm (Kerem kararı, 2026-09-02).
# En az bir tanesi zorunlu; hiçbiri yoksa not/quiz üretimi çalışmaz.
# Sıralama YETENEK sırasıdır (gözlemlenen kalite yüksekten düşüğe) — biri kota
# sınırına ulaşınca otomatik olarak sıradakine geçilir (bkz. src/services/llm_providers.py).

# 1) Google Gemini 2.5 Flash — https://aistudio.google.com/apikey (en geniş kota + en iyi Türkçe)
GOOGLE_API_KEY=

# 2) OpenRouter — https://openrouter.ai/keys (DeepSeek R1 ücretsiz varyant)
OPENROUTER_API_KEY=

# 3) Groq — https://console.groq.com/keys (Llama 3.3 70B, en yüksek hacim)
GROQ_API_KEY=

# 4) GitHub Models — GitHub PAT, "models: read" izniyle (https://github.com/settings/tokens)
GITHUB_TOKEN=

# 5) Cerebras — GEÇİCİ TEST (Kerem kararı, 2026-09-05) — https://cloud.cerebras.ai/platform/keys
CEREBRAS_API_KEY=

# İsteğe bağlı: veri dizini (varsayılan: <repo>/data)
# STUHUB_DATA_DIR=

# İsteğe bağlı: embedding modeli (varsayılan: BAAI/bge-m3)
# STUHUB_EMBED_MODEL=

# ── v2 (Niş Analizi Entegrasyonu) — tamamı isteğe bağlı ─────────────────────

# Yerel STT modeli — ses/YouTube transkripsiyonu (faster-whisper; tiny/base/small; varsayılan: small)
# STUHUB_WHISPER_MODEL=small

# OCR açık/kapalı — taranmış PDF sayfaları ve görsel materyaller (varsayılan: true)
# STUHUB_OCR_ENABLED=true

# Not dili (tr / en / auto; varsayılan: tr) — not/quiz/flashcard üretim dili
# STUHUB_NOT_DILI=tr

# Günlük hedef — streak halkası için günlük etkinlik sayısı (varsayılan: 3)
# STUHUB_DAILY_GOAL=3

# Web aramalı not yedeği — kitapta kaynak yoksa konu sorgusuyla web'de arama (varsayılan: true)
# Yalnızca "{ders adı} {konu}" sorgusu gönderilir; materyal içeriği cihazdan çıkmaz.
# STUHUB_WEB_SEARCH_ENABLED=true

# ── Üretim / deploy (Railway) ───────────────────────────────────────────────
# Bu bölüm yalnızca üretim konteyneri içindir; yerel geliştirmede gerekmez.

# Konteyner rolü: api (varsayılan) | worker. Ayrı bir worker servisi çalıştırılıyorsa
# API servisinde STUHUB_RUN_WORKERS=false yapılmalı (çifte kuyruk taraması olmasın).
# STUHUB_ROLE=api
# STUHUB_RUN_WORKERS=true

# Materyal deposu + LanceDB indeksi. Railway'de buraya KALICI BİR VOLUME bağlanmalı;
# aksi halde her deploy'da yüklenen materyaller ve vektör indeksi silinir.
# STUHUB_DATA_DIR=/data

# ÖNEMLİ: embedding modeli. Ayarlanmazsa kod varsayılanı BAAI/bge-m3 (4.3 GB) devreye
# girer; bu, mevcut indekslerle BOYUT UYUŞMAZLIĞI yaratır (bge-m3 1024, MiniLM 384) ve
# uygulama VectorDimMismatch ile durur. Değer, Dockerfile'da imaja gömülen modelle
# birebir aynı olmalıdır.
# STUHUB_EMBED_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# Tek materyal yükleme üst sınırı (bayt; varsayılan 200 MB).
# STUHUB_MAX_UPLOAD_BYTES=209715200

# Aynı anda çalışacak indeksleme işi sayısı (varsayılan 2). Her iş CPU+RAM yoğundur.
# STUHUB_INDEXER_CONCURRENCY=2

# Feed doldurucusunun bir turda işleyeceği azami ders sayısı (varsayılan 20).
# STUHUB_FEED_TOPUP_BATCH=20

# SPA ayrı bir origin'den (CDN/farklı domain) servis ediliyorsa izinli origin listesi.
# Boşsa CORS middleware hiç eklenmez (SPA backend'le aynı origin'den servis edilir).
# STUHUB_CORS_ORIGINS=https://app.ornek.com

# ── SaaS (KARAR-SAAS-GECISI.md) — boşsa yerel/tek-kullanıcı mod, auth yok ───

# Supabase proje ayarları → Project Settings → Database → Connection string (Session mode,
# `postgresql://postgres:[şifre]@[proje-ref].pooler.supabase.com:5432/postgres`).
# Doluysa uygulama SaaS moduna geçer: asyncpg + Supabase Auth zorunlu olur.
# DATABASE_URL=

# Supabase proje ayarları → JWT Settings → Legacy JWT Secret (HS256, access token doğrulama).
# SUPABASE_JWT_SECRET=

# Frontend Supabase JS istemcisi için (tarayıcıda görünür, gizli DEĞİL) — Project Settings → API.
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=

# Lemon Squeezy — abonelik/ödeme (sandbox modunda test_mode=true).
# LEMONSQUEEZY_API_KEY=
# LEMONSQUEEZY_STORE_ID=
# Webhook: Lemon Squeezy Dashboard → Settings → Webhooks → /api/billing/webhook, imza sırrı.
# LEMONSQUEEZY_WEBHOOK_SECRET=
# "Pro" plan varyant kimliği (plans.lemonsqueezy_variant_id ile eşleşir).
# LEMONSQUEEZY_PRO_VARIANT_ID=
