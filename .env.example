# StuHub DS — geliştirme ortamı değişkenleri (örnek)
# Bu dosyayı kopyalayıp `.env` olarak kaydedin ve kendi değerlerinizi girin.
# `.env` git'e GİRMEZ (bkz. .gitignore). Anahtar asla commit edilmez.

# DeepSeek API anahtarı (Faz 3'ten önce temin edilir; Ayarlar sayfasından da girilebilir)
DEEPSEEK_API_KEY=

# DeepSeek API uç noktası (varsayılan; değiştirmeniz gerekmez)
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Varsayılan model (Ayarlar sayfasından değiştirilebilir)
STUHUB_MODEL=deepseek-chat

# Uygulama veri dizini (varsayılan: repo kökünde data/ — gitignore'lu)
# STUHUB_DATA_DIR=
