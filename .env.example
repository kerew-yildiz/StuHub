# StuHub DS — ortam değişkenleri şablonu
# Bu dosyayı `.env` olarak kopyalayıp gerçek değerleri girin.
# `.env` git'e ASLA commit edilmez (.gitignore'da). Anahtarınızı kimseyle paylaşmayın.

# DeepSeek API anahtarı (https://platform.deepseek.com) — not/quiz üretimi için zorunlu
DEEPSEEK_API_KEY=

# İsteğe bağlı: API temel adresi (varsayılan resmi DeepSeek API)
DEEPSEEK_BASE_URL=https://api.deepseek.com

# İsteğe bağlı: model adı (varsayılan: deepseek-chat)
STUHUB_MODEL=deepseek-chat

# İsteğe bağlı: veri dizini (varsayılan: <repo>/data)
# STUHUB_DATA_DIR=

# İsteğe bağlı: embedding modeli (varsayılan: BAAI/bge-m3)
# STUHUB_EMBED_MODEL=
