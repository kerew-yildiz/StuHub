  "cards": [
    { "dot": "cyan", "title": "What happens here", "items": ["Your file is stored in the course folder and mined for text", "Videos and recordings are transcribed; images are read with OCR"] },
    { "dot": "emerald", "title": "Why passages", "items": ["Whole books are too big for one AI request", "Small passages can be quoted exactly, so citations stay honest"] },
