    { "id": "extract", "lane": "hub", "col": 2, "type": "backend", "label": "Pull Out the Text", "sublabel": "read pages and decks", "width": 160 },
    { "id": "chunks", "lane": "hub", "col": 3, "type": "backend", "label": "Cut into Passages", "sublabel": "a few sentences each", "width": 160 },
    { "id": "embed", "lane": "hub", "col": 4, "type": "database", "label": "Save by Meaning", "sublabel": "LanceDB vector store", "width": 160 },
    { "id": "media-branch", "lane": "media", "col": 3, "type": "external", "label": "Media Helpers", "sublabel": "yt-dlp · Whisper · OCR", "width": 160 },
    { "id": "transcribe", "lane": "media", "col": 2, "type": "backend", "label": "Turn Media into Text", "sublabel": "audio and images", "width": 160 },
